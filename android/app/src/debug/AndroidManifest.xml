<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug-only: the documented dev workflow points API_BASE_URL at a
         plain-HTTP backend (10.0.2.2 emulator alias / localhost), which
         targetSdk 36 blocks by default without this. Release builds get no
         such config and stay HTTPS-only. -->
    <application android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
